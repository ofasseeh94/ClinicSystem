# Synthetic local development only; replace placeholder password.
APP_ENV=development
POSTGRES_DB=pediatric_clinic
POSTGRES_USER=clinic_dev
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://clinic_dev:replace-with-local-password@127.0.0.1:5432/pediatric_clinic
# Windows launcher generates a random key when blank. Never commit the actual key.
DEV_AUTH_TOKEN=
DEV_CLINIC_ID=00000000-0000-0000-0000-000000000001
# Integration tests use an isolated database named *_test; never a patient database.
TEST_DATABASE_URL=
# Production only: managed identity settings and no DEV_AUTH_TOKEN.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Private attachments: base64 of 32 random bytes. Preserve the key with backups; never commit it.
# Windows launcher generates/reuses a key outside the repository when this is blank.
DOCUMENT_ENCRYPTION_KEY=
# clamav keeps uploads quarantined if the scanner is unavailable.
# synthetic permits explicitly unscanned fictional files ONLY in development/test.
DOCUMENT_SCAN_MODE=
CLAMAV_HOST=
CLAMAV_PORT=3310
